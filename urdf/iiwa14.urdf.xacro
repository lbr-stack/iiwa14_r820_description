<?xml version="1.0"?>

<!-- top level -->
<robot name="iiwa14" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- include the iiwa14 macro -->
    <xacro:include filename="$(find iiwa14_description)/urdf/iiwa14_macro.xacro" />

    <!-- arguments -->
    <xacro:arg name="robot_name" default="lbr" />
    <xacro:arg
        name="joint_limits_path"
        default="$(find iiwa14_description)/config/joint_limits.yaml" />

    <!-- iiwa14 description -->
    <xacro:iiwa14
        robot_name="$(arg robot_name)"
        joint_limits_path="$(arg joint_limits_path)" />
</robot>